from __future__ import annotations

import argparse
import re
import sqlite3
import sys
from pathlib import Path
from typing import Optional


MARKER_PATTERN = re.compile(
    r"^\s*(?:###\s*)?\[(Course|Lesson\d+|topic|content)\]\s*:\s*\{\{(.*)$",
    re.IGNORECASE,
)


def normalize_text(value: str) -> str:
    """Collapse internal whitespace while preserving readable spacing."""
    value = value.replace("\r\n", "\n").replace("\r", "\n")
    lines = [line.strip() for line in value.split("\n")]
    return "\n".join(line for line in lines if line).strip()


def extract_inline_value(raw_value: str) -> tuple[Optional[str], bool]:
    """
    Extract text from a marker body that starts after '{{'.

    Returns:
        (text, complete)
        - complete=True when the closing '}}' is found in this chunk.
        - complete=False when more lines are needed.
    """
    end_index = raw_value.find("}}")
    if end_index == -1:
        return raw_value, False
    return raw_value[:end_index], True


def initialize_database(connection: sqlite3.Connection) -> None:
    """Create the relational and FTS5 tables if they do not exist."""
    cursor = connection.cursor()
    cursor.execute(
        """
        CREATE TABLE IF NOT EXISTS documents (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            course TEXT,
            lesson TEXT,
            topic TEXT,
            content TEXT,
            seq_order INTEGER
        )
        """
    )
    cursor.execute(
        """
        CREATE VIRTUAL TABLE IF NOT EXISTS documents_fts
        USING fts5(
            id UNINDEXED,
            search_content
        )
        """
    )
    connection.commit()


def reset_tables(connection: sqlite3.Connection) -> None:
    """Clear existing rows so each import builds a fresh dataset."""
    cursor = connection.cursor()
    cursor.execute("DELETE FROM documents")
    cursor.execute("DELETE FROM documents_fts")
    connection.commit()


def insert_document(
    connection: sqlite3.Connection,
    *,
    course: Optional[str],
    lesson: Optional[str],
    topic: Optional[str],
    content: str,
    seq_order: int,
) -> None:
    """Insert one content block into both the base table and the FTS table."""
    cursor = connection.cursor()
    cursor.execute(
        """
        INSERT INTO documents (course, lesson, topic, content, seq_order)
        VALUES (?, ?, ?, ?, ?)
        """,
        (course, lesson, topic, content, seq_order),
    )
    document_id = cursor.lastrowid
    search_content = (
        f"Course: {course or ''} | "
        f"Lesson: {lesson or ''} | "
        f"Topic: {topic or ''} | "
        f"Content: {content}"
    )
    cursor.execute(
        """
        INSERT INTO documents_fts (id, search_content)
        VALUES (?, ?)
        """,
        (document_id, search_content),
    )


def parse_markdown_to_db(md_file_path: str | Path, db_path: str | Path) -> None:
    """
    Parse a structured Markdown course file and import it into SQLite.

    The importer rebuilds the target tables on each run to avoid duplicates.
    """
    markdown_path = Path(md_file_path).expanduser().resolve()
    sqlite_path = Path(db_path).expanduser().resolve()

    if not markdown_path.is_file():
        raise FileNotFoundError(f"Markdown file not found: {markdown_path}")

    sqlite_path.parent.mkdir(parents=True, exist_ok=True)

    connection: Optional[sqlite3.Connection] = None
    try:
        connection = sqlite3.connect(sqlite_path)
        initialize_database(connection)
        reset_tables(connection)

        current_course: Optional[str] = None
        current_lesson: Optional[str] = None
        current_topic: Optional[str] = None
        seq_order = 1

        active_marker: Optional[str] = None
        buffer: list[str] = []

        with markdown_path.open("r", encoding="utf-8") as source:
            for line_number, raw_line in enumerate(source, start=1):
                stripped_line = raw_line.rstrip("\n")

                if active_marker is not None:
                    chunk, complete = extract_inline_value(stripped_line)
                    buffer.append(chunk)
                    if not complete:
                        continue

                    value = normalize_text("\n".join(buffer))
                    if active_marker.lower() == "course":
                        current_course = value
                    elif active_marker.lower().startswith("lesson"):
                        current_lesson = value
                    elif active_marker.lower() == "topic":
                        current_topic = value
                    elif active_marker.lower() == "content":
                        insert_document(
                            connection,
                            course=current_course,
                            lesson=current_lesson,
                            topic=current_topic,
                            content=value,
                            seq_order=seq_order,
                        )
                        seq_order += 1

                    active_marker = None
                    buffer = []
                    continue

                match = MARKER_PATTERN.match(stripped_line)
                if not match:
                    continue

                marker_name = match.group(1)
                raw_value = match.group(2)
                chunk, complete = extract_inline_value(raw_value)

                if complete:
                    value = normalize_text(chunk)
                    if marker_name.lower() == "course":
                        current_course = value
                    elif marker_name.lower().startswith("lesson"):
                        current_lesson = value
                    elif marker_name.lower() == "topic":
                        current_topic = value
                    elif marker_name.lower() == "content":
                        insert_document(
                            connection,
                            course=current_course,
                            lesson=current_lesson,
                            topic=current_topic,
                            content=value,
                            seq_order=seq_order,
                        )
                        seq_order += 1
                else:
                    active_marker = marker_name
                    buffer = [chunk]

            if active_marker is not None:
                raise ValueError(
                    f"Unclosed marker '[{active_marker}]' near end of file: {markdown_path}"
                )

        connection.commit()
    except sqlite3.OperationalError as exc:
        if "fts5" in str(exc).lower():
            raise RuntimeError(
                "SQLite on this machine does not appear to support FTS5."
            ) from exc
        raise RuntimeError(f"SQLite operation failed: {exc}") from exc
    except OSError as exc:
        raise RuntimeError(f"File operation failed: {exc}") from exc
    except Exception:
        if connection is not None:
            connection.rollback()
        raise
    finally:
        if connection is not None:
            connection.close()


def build_argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Parse structured Markdown course content into a SQLite database."
    )
    parser.add_argument("md_file_path", help="Path to the structured Markdown file.")
    parser.add_argument("db_path", help="Path to the SQLite database file to create/update.")
    return parser


def main() -> int:
    parser = build_argument_parser()
    args = parser.parse_args()

    try:
        parse_markdown_to_db(args.md_file_path, args.db_path)
    except Exception as exc:
        print(f"Import failed: {exc}", file=sys.stderr)
        return 1

    print("Import completed successfully.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
