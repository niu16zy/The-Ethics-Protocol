LOGIC_FORTRESS_LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_OUTPUT_TOKENS=700
LOGIC_FORTRESS_LLM_MAX_ATTEMPTS=2
GROQ_API_KEY=replace-with-your-groq-key

# Temporary Fox/OpenAI-compatible Responses provider.
# Set LOGIC_FORTRESS_LLM_PROVIDER=fox to use this provider.
FOX_MODEL=gpt-5.5
FOX_BASE_URL=https://code.newcli.com/codex/v1
FOX_REASONING_EFFORT=high
FOX_DISABLE_RESPONSE_STORAGE=true
FOX_API_KEY=replace-with-your-fox-key
