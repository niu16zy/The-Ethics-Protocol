# Copy this file to .env and fill in the values you need.
# With no keys set, the backend falls back to LOGIC_FORTRESS_LLM_PROVIDER=rules
# automatically, so the app and test suite both run without any of this.

# rules | groq | fox -- leave unset to auto-detect from the keys below
LOGIC_FORTRESS_LLM_PROVIDER=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_OUTPUT_TOKENS=700

FOX_API_KEY=
FOX_MODEL=gpt-5.5
FOX_BASE_URL=https://code.newcli.com/codex/v1
FOX_REASONING_EFFORT=high

LOGIC_FORTRESS_LLM_MAX_ATTEMPTS=2

# Optional path overrides -- defaults are course_content.db and
# logic_fortress_app.db in the repository root.
# LOGIC_FORTRESS_KNOWLEDGE_DB=
# LOGIC_FORTRESS_APP_DB=
